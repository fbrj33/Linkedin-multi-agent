# ── Existing Gmail / admin config (already in use) ──────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=

# ── Groq backend ─────────────────────────────────────────────────────────────
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b

# Optional per-role overrides.
# LLM_MODEL_PLANNING=
# LLM_MODEL_CONTENT=

# ── Plan expansion ────────────────────────────────────────────────────────────
# Hours before publish time that a post's approval deadline is set to. Must
# comfortably clear the inbox poll interval below or a plan could reach
# publish time with the decision still unread.
WIMBEE_APPROVAL_LEAD_HOURS=24
WIMBEE_DEFAULT_POST_TIME=09:00

# ── Per-post approval / content quality (orchestrator/nodes_post.py) ────────
# How many times a rejected post is allowed to regenerate (generate_content
# loop, fed the rejection reason) before it's terminally rejected.
WIMBEE_REJECTION_RETRY_LIMIT=2
# score_content's rubric threshold (0-10) below which refine_content runs,
# and the cap on how many times it's allowed to loop.
WIMBEE_REFINE_SCORE_THRESHOLD=6
WIMBEE_REFINE_MAX_LOOPS=2
# verify_publish's retry count and backoff (seconds, comma-separated) for a
# failed publish attempt — short and bounded, unlike wait_for_slot's
# unbounded interrupt-based wait.
WIMBEE_PUBLISH_RETRY_LIMIT=3
WIMBEE_PUBLISH_BACKOFF_SECONDS=2,8,30

# ── Publishing ────────────────────────────────────────────────────────────────
# manual is the safe default. LinkedIn prohibits unauthorized tools that
# automate posting, so browser automation is never enabled by default.
# manual | official | relay | browser
WIMBEE_PUBLISHER=manual

# -- browser backend (Playwright, company page) --
# Required — the composer's author chip must contain this text or the
# publisher refuses to post. No default: unset means "refuse to run".
WIMBEE_ORG_NAME=
# LinkedIn company page URL slug (defaults to WIMBEE_ORG_NAME, which is
# usually NOT the real slug — set this explicitly).
WIMBEE_ORG_SLUG=
# Kill switch — the browser publisher does nothing at all unless this is
# exactly "yes".
WIMBEE_ALLOW_BROWSER_PUBLISHER=no
# Composes and screenshots the post but never clicks Post. Defaults to yes
# everywhere on purpose — flip to "no" only once you've verified on your own
# page first (see SETUP.md's testing ladder).
WIMBEE_DRY_RUN=yes
WIMBEE_ADMIN_URL=https://www.linkedin.com/company/{slug}/admin/page-posts/published/
WIMBEE_PROFILE_DIR=.li_profile
WIMBEE_MAX_POSTS_PER_DAY=3
WIMBEE_HEADLESS=true
# How long to wait for each composer selector, and for the composer to close
# after clicking Post. Raised in production for LinkedIn's real (sometimes
# slow) UI; tests lower these drastically to keep the suite fast.
WIMBEE_SELECTOR_TIMEOUT_MS=4000
WIMBEE_POST_VERIFY_TIMEOUT_MS=20000

# -- official backend (LinkedIn REST API, personal profile) --
LINKEDIN_PERSON_URN=
WIMBEE_LINKEDIN_TOKEN_FILE=linkedin_token.json
WIMBEE_LINKEDIN_API_BASE=https://api.linkedin.com/v2
WIMBEE_LINKEDIN_API_TIMEOUT=15

# -- relay backend (Make / Zapier / Ayrshare webhook) --
WIMBEE_RELAY_WEBHOOK_URL=
WIMBEE_RELAY_TIMEOUT=15

# ── Timezone ──────────────────────────────────────────────────────────────────
# Post.scheduled_date/scheduled_time are local wall-clock strings in this
# zone; every other timestamp in the schema is naive UTC. plan_expander.py
# and orchestrator/nodes_post.py::wait_for_slot are the two places that
# convert between them — see plan_expander.py's module docstring for why
# this mixing exists and how it's handled.
WIMBEE_TIMEZONE=Africa/Tunis

# ── LangGraph checkpointer (orchestrator/checkpointer.py) ────────────────────
# Deliberately a SEPARATE file from wimbee.db — SQLite allows one writer per
# file, and the checkpointer writes on every node transition, far more often
# than a Post row changes. Sharing one file would mean an in-flight publish
# could block an analytics read. Both files run in WAL mode.
WIMBEE_CHECKPOINT_DB=wimbee_checkpoints.db

# ── Scheduler (scheduling/scheduler.py) — pure resumption driver ─────────────
# It owns no business logic: every job either resumes a graph thread or
# sends an email. Starting a brand-new plan thread is NOT a job — that's
# `python main.py plan <month>`, run manually or from your own cron.
WIMBEE_INBOX_POLL_MINUTES=15
WIMBEE_SLOT_SWEEP_MINUTES=5
WIMBEE_REMINDER_SWEEP_MINUTES=60
# Hours before a plan/post approval deadline that a single reminder email
# fires (guarded by graph_thread.reminder_sent_at — won't re-nudge every tick).
WIMBEE_REMINDER_HOURS_BEFORE_DEADLINE=6

# ── Testing / advanced ───────────────────────────────────────────────────────
# Redirects the SQLAlchemy engine / LangGraph checkpointer to different
# files — tests/conftest.py sets both to isolated throwaway paths so the
# test suite never touches wimbee.db or wimbee_checkpoints.db. Leave unset
# in normal operation.
# WIMBEE_DATABASE_URL=sqlite:///wimbee.db
